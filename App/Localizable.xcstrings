    "Dev Manager": {
      "shouldTranslate": false
    },
    "Dev Manager is a companion app for LG webOS TVs in Developer Mode or with root access. Manage your TV from your iPhone over your local network.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dev Manager è un’app di supporto per le TV LG webOS con Developer Mode o con accesso root. Gestisci la TV da iPhone tramite la rete locale."
          }
        }
