    },
    "%@ sign in with this certificate and couldn't connect without it. Choose another sign-in method in Manage TVs first.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ accedono con questo certificato e senza non potrebbero più connettersi. Prima scegli un altro metodo di accesso in Gestisci TV."
          }
        }
      }
    },
